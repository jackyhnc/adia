# Stripe — leave blank to ship without payments (pricing page falls back gracefully)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_LIFETIME=

# Resend (transactional email) — without this, license emails are logged instead of sent
RESEND_API_KEY=
RESEND_FROM="Adia <hello@adia.app>"

# License DB
#  - dev/test (default): SQLite at $LICENSE_DB_PATH (or ./.data/adia.db)
#  - production:         set DATABASE_URL=postgres://... (Neon/Vercel Postgres) and lib/store.ts
#                        automatically uses the Postgres adapter (lib/db-pg.ts)
LICENSE_DB_PATH=
DATABASE_URL=

# Admin: bearer token for /api/admin/lookup + /admin page. Must be set or admin returns 401.
ADMIN_TOKEN=

# Site URL — used in sitemap, OG, robots
NEXT_PUBLIC_SITE_URL=https://adia.app
